# ===== LLM Wiki 环境变量示例 =====
# 复制为 .env 后按需修改（本地开发可全部留空，程序有安全默认值）。

# API 服务监听端口与地址
PORT=4000
HOST=0.0.0.0

# Web 访问 API 的地址（前端运行时读取，必须以 NEXT_PUBLIC_ 前缀暴露给浏览器）
NEXT_PUBLIC_API_URL=http://localhost:4000

# SQLite 数据库：文档元数据 + 知识页 + RAG 证据片段
DATABASE_PATH=./data/llmwiki.db

# DeepSeek：优先读取直接环境变量；也可只配置凭证中心 YAML 路径
# DEEPSEEK_API_KEY=sk-****
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_CREDENTIALS_PATH=/absolute/path/to/.credentials.yaml
