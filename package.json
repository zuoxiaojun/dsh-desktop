{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop - Electron client for DeepSeek Harness",
  "type": "module",
  "scripts": {
    "dev:desktop": "tsx apps/desktop/scripts/dev-desktop.ts",
    "dev:desktop:rebuild": "tsx apps/desktop/scripts/dev-desktop.ts --rebuild",
    "build": "tsdown -c apps/desktop/tsdown.config.ts",
    "package": "pnpm run build && electron-builder --dir -c apps/desktop/electron-builder.config.js",
    "dist": "pnpm run build && electron-builder -c apps/desktop/electron-builder.config.js",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
